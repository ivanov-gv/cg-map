{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interior building address label feature",
  "type": "object",
  "required": [
    "type",
    "id",
    "geometry",
    "properties"
  ],
  "properties": {
    "type": {
      "const": "Feature"
    },
    "id": {
      "type": "string",
      "pattern": "^way/[0-9]+$"
    },
    "geometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "properties": {
      "type": "object",
      "required": [
        "kind",
        "osm_id",
        "footprintIndex",
        "addr:housenumber",
        "address_sources"
      ],
      "properties": {
        "kind": {
          "const": "building"
        },
        "osm_id": {
          "type": "string",
          "pattern": "^way/[0-9]+$"
        },
        "footprintIndex": {
          "type": "integer",
          "minimum": 0
        },
        "addr:housenumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "addr:street": {
          "type": "string"
        },
        "address_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(way|node)/[0-9]+$"
          }
        }
      }
    }
  }
}
