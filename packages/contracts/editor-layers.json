{
  "version": 1,
  "localPlaceSource": "Local correction",
  "layers": {
    "places.geojson": {
      "operations": ["add", "modify", "delete"],
      "geometries": ["Point"],
      "properties": {
        "name": {"required": true, "maxLength": 120},
        "name:en": {"maxLength": 120},
        "name:sr-Latn": {"maxLength": 120},
        "category": {"required": true, "enum": ["food", "sights", "shops", "stay", "essentials"]},
        "kind": {"required": true, "maxLength": 64},
        "standalone": {"type": "boolean"},
        "visibilityLevel": {"required": true, "isLevel": true, "landmarkLevel": 1, "landmarkCategory": "sights"},
        "addr:street": {"maxLength": 120},
        "addr:housenumber": {"maxLength": 128},
        "phone": {"maxLength": 64},
        "website": {"maxLength": 512},
        "email": {"maxLength": 128},
        "opening_hours": {"maxLength": 256},
        "wheelchair": {"maxLength": 64},
        "level": {"maxLength": 16},
        "cuisine": {"maxLength": 128},
        "wikidata": {"maxLength": 64},
        "wikipedia": {"maxLength": 128}
      }
    },
    "building-entrances.geojson": {
      "operations": [],
      "geometries": ["Point"],
      "readOnlyReason": "OSM entrance nodes from the reviewed extract. Change them through a data-owned refresh.",
      "properties": {}
    },
    "settlements.geojson": {
      "operations": [],
      "geometries": [],
      "readOnlyReason": "OSM settlement snapshot. Public town labels move into data in a separate Feature.",
      "properties": {}
    },
    "border-edges.geojson": {
      "operations": [],
      "geometries": [],
      "readOnlyReason": "Shared edges are rebuilt from OSM boundaries; an edge move changes every municipality that uses it.",
      "properties": {}
    },
    "municipalities.geojson": {
      "operations": [],
      "geometries": [],
      "readOnlyReason": "Municipality polygons are rebuilt from shared edges in the data pipeline.",
      "properties": {}
    },
    "buildings.geojson": {
      "operations": ["modify"],
      "geometries": ["Polygon"],
      "properties": {
        "building": {"maxLength": 64},
        "building:levels": {"maxLength": 32},
        "building:material": {"maxLength": 128},
        "start_date": {"maxLength": 32},
        "roof:levels": {"maxLength": 32},
        "name": {"maxLength": 120},
        "addr:street": {"maxLength": 120},
        "addr:housenumber": {
          "maxLength": 128,
          "ignoredCharactersPattern": "[\\s./_-]",
          "forbiddenValues": ["", "bb", "бб", "bezbroja", "безброја", "na", "?"]
        }
      }
    },
    "building-labels.geojson": {
      "operations": ["modify"],
      "geometries": ["Point"],
      "properties": {
        "addr:housenumber": {
          "required": true,
          "maxLength": 128,
          "ignoredCharactersPattern": "[\\s./_-]",
          "forbiddenValues": ["", "bb", "бб", "bezbroja", "безброја", "na", "?"]
        },
        "addr:street": {"maxLength": 120}
      }
    },
    "roads.geojson": {
      "operations": ["add", "modify", "delete"],
      "geometries": ["LineString"],
      "properties": {
        "name": {"maxLength": 120},
        "name:en": {"maxLength": 120},
        "kind": {
          "required": true,
          "enum": [
            "motorway",
            "motorway_link",
            "trunk",
            "trunk_link",
            "primary",
            "primary_link",
            "secondary",
            "secondary_link",
            "tertiary",
            "unclassified",
            "residential",
            "service",
            "pedestrian",
            "footway",
            "path",
            "track",
            "cycleway",
            "steps",
            "living_street"
          ]
        },
        "bridge": {"maxLength": 64},
        "tunnel": {"maxLength": 64},
        "layer": {"maxLength": 16},
        "oneway": {"maxLength": 16},
        "access": {"maxLength": 64},
        "motor_vehicle": {"maxLength": 64},
        "foot": {"maxLength": 64},
        "bicycle": {"maxLength": 64},
        "maxspeed": {"maxLength": 32},
        "surface": {"maxLength": 64},
        "lit": {"maxLength": 16},
        "sac_scale": {"maxLength": 64},
        "smoothness": {"maxLength": 64},
        "parking:left": {"maxLength": 128},
        "parking:right": {"maxLength": 128},
        "parking:both": {"maxLength": 128},
        "junction": {"maxLength": 64},
        "ref": {"maxLength": 120},
        "pathClass": {"enum": ["main", "trail"]}
      }
    },
    "road-nodes.geojson": {
      "operations": [],
      "geometries": ["Point"],
      "readOnlyReason": "Extracted from OSM; edit through a data-owned refresh.",
      "properties": {}
    },
    "land.geojson": {
      "operations": ["modify"],
      "geometries": ["Polygon"],
      "editableKinds": [
        "park",
        "garden",
        "woods",
        "meadow",
        "grass",
        "scrub",
        "sports",
        "cemetery",
        "playground"
      ],
      "inspectOnlyReason": "Country and context outlines mirror their sources and need a data-owned refresh.",
      "properties": {
        "kind": {
          "required": true,
          "enum": [
            "park",
            "garden",
            "woods",
            "meadow",
            "grass",
            "scrub",
            "sports",
            "cemetery",
            "playground"
          ]
        },
        "name": {"maxLength": 120},
        "name:en": {"maxLength": 120}
      }
    },
    "water.geojson": {
      "operations": ["modify"],
      "geometries": ["Polygon", "LineString"],
      "editableKinds": [
        "lake",
        "river",
        "reservoir",
        "pond",
        "basin",
        "water",
        "stream",
        "canal",
        "ditch",
        "drain",
        "coastline"
      ],
      "inspectOnlyReason": "The ocean polygon is derived by the data pipeline.",
      "properties": {
        "kind": {
          "required": true,
          "enum": [
            "lake",
            "river",
            "reservoir",
            "pond",
            "basin",
            "water",
            "stream",
            "canal",
            "ditch",
            "drain",
            "coastline"
          ]
        },
        "name": {"maxLength": 120},
        "name:en": {"maxLength": 120}
      }
    },
    "context-countries.geojson": {
      "operations": [],
      "geometries": [],
      "readOnlyReason": "Natural Earth context preserved from its source. Change it through a data-owned refresh.",
      "properties": {}
    },
    "transport-stops.geojson": {
      "operations": [],
      "geometries": [],
      "readOnlyReason": "Dated ePodgorica data, duplicated in transit-network.json. Change it through the transit import.",
      "properties": {}
    },
    "contours.geojson": {
      "operations": [],
      "geometries": [],
      "readOnlyReason": "Computed from the Copernicus DEM, one LineString per contour. Rebuild with make -C data build-relief.",
      "properties": {}
    },
    "summits.geojson": {
      "operations": [],
      "geometries": [],
      "readOnlyReason": "OSM summit facts with DEM checks. Fix the upstream OSM object or rebuild the relief sources.",
      "properties": {}
    },
    "slopes.geojson": {
      "operations": [],
      "geometries": [],
      "readOnlyReason": "Computed from the DEM and reviewed green areas, one Polygon per slope. Rebuild with make -C data build-relief.",
      "properties": {}
    },
    "ridges.geojson": {
      "operations": [],
      "geometries": [],
      "readOnlyReason": "Computed aspect boundaries near OSM summits. Rebuild with make -C data build-relief.",
      "properties": {}
    },
    "canyon-rims.geojson": {
      "operations": [],
      "geometries": [],
      "readOnlyReason": "Computed from DEM canyon banks, one LineString per segment. Rebuild with make -C data build-relief.",
      "properties": {}
    }
  }
}
