{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned editor source bundle",
  "description": "Version 1 pins the original eight source files; version 2 the thirteen of the OSM sources; version 3 adds relief, protected areas, routes and turn restrictions, so every object on the map has its source in the bundle; version 4 adds editable bridge outlines and railways but leaves derived slopes to the editor's preview. Versions are frozen once released.",
  "type": "object",
  "required": ["version", "layers"],
  "additionalProperties": false,
  "properties": {
    "version": {"enum": [1, 2, 3, 4]},
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "sha256", "bytes", "featureCount"],
        "properties": {
          "filename": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "featureCount": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "version": {"const": 1},
        "layers": {
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "properties": {
              "filename": {
                "enum": [
                  "building-labels.geojson",
                  "buildings.geojson",
                  "context-countries.geojson",
                  "land.geojson",
                  "places.geojson",
                  "roads.geojson",
                  "transport-stops.geojson",
                  "water.geojson"
                ]
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "version": {"const": 2},
        "layers": {
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "properties": {
              "filename": {
                "enum": [
                  "border-edges.geojson",
                  "building-entrances.geojson",
                  "building-labels.geojson",
                  "buildings.geojson",
                  "context-countries.geojson",
                  "land.geojson",
                  "municipalities.geojson",
                  "places.geojson",
                  "road-nodes.geojson",
                  "roads.geojson",
                  "settlements.geojson",
                  "transport-stops.geojson",
                  "water.geojson"
                ]
              }
            }
          }
        }
      }
    },
    {
      "$comment": "Version 4 is listed before version 3 because the current producer takes oneOf.at(-1) as the version it emits.",
      "properties": {
        "version": {"const": 4},
        "layers": {
          "minItems": 23,
          "maxItems": 23,
          "items": {
            "properties": {
              "filename": {
                "enum": [
                  "border-edges.geojson",
                  "bridges.geojson",
                  "building-entrances.geojson",
                  "building-labels.geojson",
                  "buildings.geojson",
                  "canyon-rims.geojson",
                  "context-countries.geojson",
                  "contours.geojson",
                  "land.geojson",
                  "municipalities.geojson",
                  "places.geojson",
                  "protected-areas.geojson",
                  "railways.geojson",
                  "ridges.geojson",
                  "road-nodes.geojson",
                  "roads.geojson",
                  "settlement-areas.geojson",
                  "settlements.geojson",
                  "summits.geojson",
                  "transit-routes.json",
                  "transport-stops.geojson",
                  "turn-restrictions.json",
                  "water.geojson"
                ]
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "version": {"const": 3},
        "layers": {
          "minItems": 22,
          "maxItems": 22,
          "items": {
            "properties": {
              "filename": {
                "enum": [
                  "border-edges.geojson",
                  "building-entrances.geojson",
                  "building-labels.geojson",
                  "buildings.geojson",
                  "canyon-rims.geojson",
                  "context-countries.geojson",
                  "contours.geojson",
                  "land.geojson",
                  "municipalities.geojson",
                  "places.geojson",
                  "protected-areas.geojson",
                  "ridges.geojson",
                  "road-nodes.geojson",
                  "roads.geojson",
                  "settlement-areas.geojson",
                  "settlements.geojson",
                  "slopes.geojson",
                  "summits.geojson",
                  "transit-routes.json",
                  "transport-stops.geojson",
                  "turn-restrictions.json",
                  "water.geojson"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
