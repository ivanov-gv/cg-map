{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivanov-gv/cg-map/contracts/relief/v1",
  "title": "Relief source features v1",
  "description": "Relief vectors derived from Copernicus DEM GLO-30 and reviewed OSM/source geometry. Features carry object facts only; build parameters, source descriptions and full report results live in data/sources/provenance.json and the temporary relief report. Identity follows entity-identity.schema.json. Contours, ridges and canyon rim parts are one LineString feature each; every canyon rim keeps the low side on its right and every contour with higher ground on its left; slopes are one Polygon feature each. Derived IDs are deterministic for pinned inputs but are not stable across DEM or green-area changes.",
  "type": "object",
  "required": ["type", "entitySchemaVersion", "features"],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "entitySchemaVersion": {"const": 1},
    "features": {
      "type": "array",
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "geometry": {"type": "object", "required": ["type", "coordinates"]},
        "properties": {
          "type": "object",
          "required": ["entityId", "entityVersion", "kind"],
          "properties": {
            "kind": {"enum": ["contour", "summit", "slope", "ridge", "canyon-rim"]},
            "entityPart": {"type": "integer", "minimum": 0},
            "source": false
          },
          "allOf": [
            {"$ref": "#/$defs/contour"},
            {"$ref": "#/$defs/summit"},
            {"$ref": "#/$defs/slope"},
            {"$ref": "#/$defs/ridge"},
            {"$ref": "#/$defs/canyonRim"}
          ]
        }
      }
    },
    "contour": {
      "if": {"properties": {"kind": {"const": "contour"}}, "required": ["kind"]},
      "then": {
        "required": ["elevation", "index"],
        "properties": {
          "elevation": {"type": "integer", "multipleOf": 20},
          "index": {"type": "boolean"}
        }
      }
    },
    "summit": {
      "if": {"properties": {"kind": {"const": "summit"}}, "required": ["kind"]},
      "then": {
        "required": ["natural", "ele"],
        "if": {"properties": {"entityId": {"not": {"pattern": "^local:"}}}},
        "then": {"required": ["demElevation", "surroundingDemElevation", "enclosingContourElevation", "heightCheck", "mismatch", "mismatchReasons"]},
        "properties": {
          "natural": {"enum": ["peak", "hill"]},
          "name": {"type": "string"},
          "name:en": {"type": "string"},
          "ele": {"type": ["number", "null"]},
          "demElevation": {"type": "number"},
          "surroundingDemElevation": {"type": "number"},
          "enclosingContourElevation": {"type": ["integer", "null"]},
          "heightCheck": {"enum": ["missing", "mismatch", "ok"]},
          "mismatch": {"type": "boolean"},
          "mismatchReasons": {"type": "array", "items": {"type": "string"}},
          "minzoom": {"type": "integer", "minimum": 4, "maximum": 16}
        }
      }
    },
    "slope": {
      "if": {"properties": {"kind": {"const": "slope"}}, "required": ["kind"]},
      "then": {
        "required": ["aspect", "areaSquareMetres"],
        "properties": {
          "aspect": {"enum": ["sunlit", "shaded"]},
          "areaSquareMetres": {"type": "number"},
          "greenKinds": false,
          "greenKindsPresentInLand": false,
          "minimumAreaSquareMetres": false
        }
      }
    },
    "ridge": {
      "if": {"properties": {"kind": {"const": "ridge"}}, "required": ["kind"]},
      "then": {
        "required": ["sunlitSide", "shadedSide"],
        "dependentRequired": {"summit": ["summitName"], "summitName": ["summit"]},
        "properties": {
          "summit": {"type": "string", "pattern": "^((node|way|relation)/[1-9][0-9]*|local:[0-9a-f-]{36})$"},
          "summitName": {"type": "string"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "sunlitSide": {"type": "string"},
          "shadedSide": {"type": "string"},
          "radiusMetres": false
        }
      }
    },
    "canyonRim": {
      "if": {"properties": {"kind": {"const": "canyon-rim"}}, "required": ["kind"]},
      "then": {
        "required": ["method", "lengthMetres"],
        "properties": {
          "river": {"enum": ["Morača", "Ribnica"]},
          "bank": {"enum": ["left", "right"]},
          "method": {"enum": ["osm-cliff", "dem-canyon-bank", "editor-drawn"]},
          "height": {"type": "integer"},
          "width": {"type": "integer", "description": "Whole metres from rim to slope foot, painted by the owner. An omitted width means 0 m: a vertical edge."},
          "lengthMetres": {"type": "number", "minimum": 0},
          "bankDefinition": false,
          "cliffWays": false,
          "cliffLengthMetres": false,
          "demLengthMetres": false,
          "segmentLengthMetres": false,
          "segmentBankRiseMetres": false,
          "minimumBankRiseMetres": false,
          "searchDistanceMetres": false,
          "searchStepMetres": false
        },
        "allOf": [
          {
            "if": {"properties": {"method": {"const": "editor-drawn"}}, "required": ["method"]},
            "then": {"properties": {"river": false, "bank": false}},
            "else": {"required": ["river", "bank"]}
          }
        ]
      }
    }
  }
}
