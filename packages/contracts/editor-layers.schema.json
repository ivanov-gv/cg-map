{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editing rules per source file",
  "type": "object",
  "required": ["version", "localPlaceSource", "layers"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 2},
    "localPlaceSource": {
      "description": "The source property of a place created in the editor.",
      "type": "string",
      "minLength": 1
    },
    "layers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["operations", "geometries", "properties"],
        "additionalProperties": false,
        "properties": {
          "operations": {"type": "array", "items": {"enum": ["add", "modify", "delete"]}, "uniqueItems": true},
          "geometries": {"type": "array", "items": {"enum": ["Point", "LineString", "Polygon", "MultiPolygon", "None"]}},
          "editableKinds": {"type": "array", "items": {"type": "string"}},
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "required": {"type": "boolean"},
                "maxLength": {"type": "integer", "minimum": 1},
                "enum": {"type": "array", "items": {"type": "string"}},
                "isLevel": {"type": "boolean"},
                "landmarkLevel": {"description": "A level only places in landmarkCategory may have.", "type": "integer"},
                "landmarkCategory": {"type": "string"},
                "ignoredCharactersPattern": {
                  "description": "Removed, with case folding, before comparing a value with forbiddenValues.",
                  "type": "string"
                },
                "forbiddenValues": {"type": "array", "items": {"type": "string"}},
                "type": {
                  "description": "Text when absent. directions is the ordered stop list of a route; entrances are the located entrances of a label, which follow the walls of their building; list is an array of texts; a position is a WGS84 longitude/latitude pair and positions is a line of them; an identifier is an OSM number or the local ID of an object added in the editor, and identifiers are a list of them.",
                  "enum": ["integer", "number", "boolean", "list", "position", "positions", "identifier", "identifiers", "directions", "entrances"]
                },
                "minimum": {"type": "number"},
                "maximum": {"type": "number"},
                "multipleOf": {"type": "number"},
                "pattern": {"type": "string"},
                "allowsNull": {"description": "A missing fact is recorded as null.", "type": "boolean"},
                "reference": {
                  "description": "The named file holds the object whose entity ID is the value.",
                  "type": "string"
                },
                "addOnly": {
                  "description": "Only a new object states it; afterwards it is identity and stays locked.",
                  "type": "boolean"
                },
                "requiredOnAdd": {"type": "boolean"}
              }
            }
          },
          "limitedKinds": {
            "description": "What a kind the pipeline derives, or that only frames the map, allows instead of the file's rules.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["operations", "geometry", "properties"],
              "additionalProperties": false,
              "properties": {
                "operations": {"type": "array", "items": {"enum": ["add", "modify", "delete"]}},
                "geometry": {"type": "boolean"},
                "properties": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "derivedGeometry": {
            "description": "The editor computes this geometry from an edit of another object, such as a shared border; only its structure is checked.",
            "type": "boolean"
          },
          "requiredAny": {
            "description": "A feature needs at least one of these properties.",
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
