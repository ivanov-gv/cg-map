{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transit routes version 5",
  "description": "Pending bundle version 5: directions name transport stops by stopId. A {turn: [longitude, latitude]} item is a genuine turn point, not a stop, and is not checked against transport-stops.geojson.",
  "type": "object",
  "required": ["version", "retrievedAt", "source", "routes"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 5},
    "retrievedAt": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["network", "directions"],
        "additionalProperties": false,
        "properties": {
          "number": {"type": "string", "minLength": 1, "description": "OSM ref; omitted when the source does not publish one"},
          "name": {"type": "string"},
          "network": {"enum": ["bus", "intercity"]},
          "colour": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
          "directions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["headsign", "stops"],
              "additionalProperties": false,
              "properties": {
                "headsign": {"type": "string"},
                "stops": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "description": "stopId of a stop in transport-stops.geojson"
                      },
                      {
                        "type": "object",
                        "required": ["turn"],
                        "additionalProperties": false,
                        "properties": {
                          "turn": {
                            "type": "array",
                            "prefixItems": [{"type": "number"}, {"type": "number"}],
                            "minItems": 2,
                            "maxItems": 2,
                            "description": "WGS84 [longitude, latitude] point the route must pass, not a stop"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
