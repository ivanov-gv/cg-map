{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Representative bus network version 5",
  "description": "Pending bundle version 5: the stops dictionary and each pattern name stops by stopId. Data checks that every pattern stopId exists in the dictionary and in transport-stops.geojson; a content schema cannot check across files.",
  "type": "object",
  "required": ["version", "retrievedAt", "source", "stops", "patterns"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 5},
    "retrievedAt": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "stops": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9_-]+$"},
      "additionalProperties": {
        "type": "object",
        "required": ["name", "coordinates"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "coordinates": {
            "type": "array",
            "prefixItems": [{"type": "number"}, {"type": "number"}],
            "minItems": 2,
            "maxItems": 2,
            "description": "WGS84 [longitude, latitude]"
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["route", "name", "headsign", "stops", "offsets"],
        "additionalProperties": false,
        "properties": {
          "route": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "headsign": {"type": "string"},
          "stops": {
            "type": "array",
            "minItems": 2,
            "maxItems": 300,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "description": "stopId in the stops dictionary and in transport-stops.geojson"}
          },
          "offsets": {
            "type": "array",
            "minItems": 2,
            "maxItems": 300,
            "items": {"type": "number", "minimum": 0, "maximum": 172800}
          }
        }
      }
    }
  }
}
