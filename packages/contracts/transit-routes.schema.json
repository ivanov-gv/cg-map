{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transit route network v1",
  "type": "object",
  "required": [
    "version",
    "retrievedAt",
    "source",
    "routes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "retrievedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "number",
          "name",
          "network",
          "directions"
        ],
        "properties": {
          "number": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "network": {
            "enum": [
              "bus",
              "intercity"
            ]
          },
          "colour": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "osm_id": {
            "type": "string",
            "pattern": "^relation/\\d+$"
          },
          "osm_version": {
            "type": "integer",
            "minimum": 1
          },
          "directions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "headsign",
                "stops"
              ],
              "properties": {
                "headsign": {
                  "type": "string"
                },
                "stops": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
