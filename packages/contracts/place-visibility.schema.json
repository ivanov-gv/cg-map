{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivanov-gv/cg-map/contracts/place-visibility/v1",
  "title": "Place visibility levels v1",
  "description": "Level 1 appears earliest. Levels are consecutive from 1 and minZoom strictly increases, so eligibility is cumulative as zoom increases. legacyFallbackLevel applies only to consumers reading a place with no visibilityLevel.",
  "type": "object",
  "required": ["version", "legacyFallbackLevel", "levels"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "legacyFallbackLevel": {"type": "integer", "minimum": 2},
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["level", "minZoom"],
        "additionalProperties": false,
        "properties": {
          "level": {"type": "integer", "minimum": 1},
          "minZoom": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
