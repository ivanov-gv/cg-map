{
  "name": "@ivanov-gv/map-contracts",
  "version": "0.0.0-dev",
  "type": "module",
  "description": "Versioned formats shared by Kompas map producers and consumers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanov-gv/cg-map.git",
    "directory": "packages/contracts"
