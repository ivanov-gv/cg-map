# Replace the domain and root with your own values.
maps.example.org {
    root * /srv/kompas/current/dist/web
    @shell not path /data/*.pmtiles
    header @shell Cache-Control "no-cache"
    @archives path /data/*.pmtiles
    header @archives Cache-Control "public, max-age=31536000, immutable"
    file_server
}
