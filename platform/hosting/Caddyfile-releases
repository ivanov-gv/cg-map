# Optional release layout retaining archives for clients on older app versions.
maps.example.org {
    @archives path /data/montenegro-*.pmtiles
    handle @archives {
        root * /srv/kompas/archives
        uri strip_prefix /data
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv/kompas/current/dist/web
        header Cache-Control "no-cache"
        file_server
    }
}
