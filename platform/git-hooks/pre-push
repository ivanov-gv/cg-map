#!/bin/sh
# Only the checks selected by the pushed refs; a failing plan falls back to the full local gate.
set -eu
hooks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$(git rev-parse --show-toplevel)"
# Git exports these to hooks. Left set, a `git init` in any check would write to this repository's shared config.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR
exec node "$hooks_dir/../tools/pre-push-plan.mjs"
