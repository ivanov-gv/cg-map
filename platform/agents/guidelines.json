{
  "$comment": "Single mapping from canonical guideline docs to agent adapters: `paths` become .claude/rules frontmatter, `components` get the generated AGENTS.md block. Edit here, then run `make agent-rules`. See docs/engineering/README.md.",
  "limits": {
    "rootAgentsMaxLines": 100,
    "guidelineMaxBytes": 8192,
    "codexChainMaxBytes": 32768
  },
  "guidelines": [
    {
      "id": "javascript",
      "source": "docs/engineering/javascript.md",
      "paths": ["**/*.js", "**/*.mjs", "**/package.json"],
      "components": ["apps/web", "data", "platform", "services/transit-relay"]
    },
    {
      "id": "ui",
      "source": "docs/engineering/ui.md",
      "paths": ["apps/web/public/**", "apps/web/src/**"],
      "components": ["apps/web"]
    },
    {
      "id": "python",
      "source": "docs/engineering/python.md",
      "paths": ["**/*.py", "**/requirements*.txt"],
      "components": ["data", "platform"]
    },
    {
      "id": "go",
      "source": "docs/engineering/go.md",
      "paths": ["**/*.go", "**/go.mod", "**/go.sum", "**/go.work"],
      "components": ["services/backend"]
    }
  ]
}
