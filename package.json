{
  "name": "cg-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-tiles.mjs && python3 tools/pack.py && node tools/finalize.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup": "npm ci --ignore-scripts",
    "dev": "python3 server.py",
    "lint": "eslint web/*.js tools/*.mjs tests *.mjs",
    "check:data": "node tools/check-data.mjs",
    "check:repo": "node tools/check-repo.mjs",
    "check:pages": "node tools/publish-pages.mjs --check",
    "check": "npm run lint && npm run check:data && npm run check:repo && npm test && python3 -m unittest discover -s tests -p \"test_*.py\" && python3 -m py_compile server.py tools/*.py && npm run check:offline && npm run check:pages",
    "release:prepare": "node tools/finalize.mjs && node tools/publish-pages.mjs",
    "build:static": "node tools/build-static.mjs",
    "test:e2e": "playwright test",
    "check:offline": "node tools/finalize.mjs --check"
  },
  "dependencies": {
    "@mapbox/vector-tile": "2.0.4",
    "geojson-vt": "4.0.2",
    "maplibre-gl": "5.12.0",
    "pbf": "4.0.1",
    "pmtiles": "4.3.0",
    "vt-pbf": "3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
