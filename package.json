{
  "name": "cg-map-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci --ignore-scripts",
    "lint:md": "markdownlint-cli2 && prettier --check --ignore-path .gitignore \"**/*.md\"",
    "format:md": "node platform/tools/format-markdown.mjs",
    "check:repo": "node platform/tools/check-repo.mjs",
    "check:agents": "node platform/agents/gen-agent-rules.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mapbox/vector-tile": "2.0.4",
    "ajv": "8.18.0",
    "eslint": "10.13.0",
    "espree": "11.2.0",
    "globals": "17.13.0",
    "markdownlint-cli2": "0.24.0",
    "pbf": "4.0.1",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "markdownlint": {
      "re2js": "2.8.7"
    },
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  },
  "workspaces": [
    "apps/web",
    "data",
    "packages/map-core",
    "apps/core-demo",
    "apps/editor"
  ]
}
