{
  "name": "@cg-map/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src tools tests playwright.config.mjs",
    "test": "node --test $(find src tests tools \\( -name '*.test.js' ! -name '*.browser.test.js' -o -name '*.test.mjs' \\) | sort)",
    "build": "node tools/build.mjs",
    "pretest:e2e": "MAP_DATA_ROOT=\"$(node tests/pinned-data.mjs)\" MAP_CONTRACTS_ROOT=\"$(node tests/pinned-contracts.mjs)\" npm run build",
    "test:e2e": "playwright test",
    "test:e2e:built": "playwright test"
  },
  "devDependencies": {
    "@ivanov-gv/map-contracts": "0.1.0",
    "@ivanov-gv/map-data": "0.1.0",
    "@playwright/test": "1.56.1"
  },
  "dependencies": {
    "@ivanov-gv/map-core": "0.2.0"
  }
}
